# Pantry API backend URL — used by Next.js server-side rewrites that proxy /v1/* and /health
PANTRY_API_URL=http://localhost:7721

# Pantry API backend URL exposed to the browser — used for client-side Forge generation calls
# (these bypass the rewrite proxy to avoid timeouts on long-running generations)
NEXT_PUBLIC_PANTRY_API_URL=http://localhost:7721

# Dev/prod server port
PORT=7720

# Cloudflare Web Analytics beacon token — public, inlined into the client bundle
# at build time. Create a manual site for pantry.jarvisautomation.io in the
# Cloudflare dashboard (Web Analytics -> Add a site) and paste its token. Must be
# pantry's OWN token — sharing another host's token gets beacons CORS-rejected.
# Unset = analytics disabled (no-op). For prod it's set via fly.toml build.args.
NEXT_PUBLIC_CF_BEACON_TOKEN=
